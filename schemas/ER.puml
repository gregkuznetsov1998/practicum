@startuml ERDiagram
title ER-диаграмма - Управление умным домом

' *********************
' Основные сущности
' *********************

entity users {
  *id : INTEGER <<PK>>
  --
  *username : VARCHAR(50)
  *email : VARCHAR(100)
  *password_hash : VARCHAR(255)
  created_at : TIMESTAMP
  last_login : TIMESTAMP
}

entity houses {
  *id : INTEGER <<PK>>
  --
  *name : VARCHAR(100)
  address : TEXT
  *owner_id : INTEGER <<FK>>
}

entity rooms {
  *id : INTEGER <<PK>>
  --
  *name : VARCHAR(100)
  *house_id : INTEGER <<FK>>
  description : TEXT
}

entity device_types {
  *id : INTEGER <<PK>>
  --
  *name : VARCHAR(50)
  *description : TEXT
  *measurement_unit : VARCHAR(20)
}

entity sensors {
  *id : INTEGER <<PK>>
  --
  *name : VARCHAR(100)
  *type_id : INTEGER <<FK>>
  *room_id : INTEGER <<FK>>
  *status : VARCHAR(20)
  installation_date : DATE
  last_maintenance : DATE
}

entity telemetry_data {
  *id : BIGINT <<PK>>
  --
  *sensor_id : INTEGER <<FK>>
  *value : FLOAT
  *timestamp : TIMESTAMP
  quality : VARCHAR(20)
}

' *********************
' Связи между сущностями
' *********************

users ||--o{ houses : "owns"
houses ||--o{ rooms : "contains"
rooms ||--o{ sensors : "located_in"
device_types ||--o{ sensors : "classified_as"
sensors ||--o{ telemetry_data : "produces"

' *********************
' Примеры данных
' *********************

